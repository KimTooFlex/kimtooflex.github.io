{
  "title": "KimTools.WinForms",
  "url": "https://kimtoo.net",
  "engine": "js",
  "src": "src",
  "out": "docs",
  "base": "/docs/",
  "favicon": "/assets/images/favicon.ico",
  "theme": {
    "name": "default",
    "appearance": "light",
    "customCss": [
      "/assets/css/kimtools.css"
    ]
  },
  "customJs": [
    "/assets/js/kimtools.js"
  ],
  "logo": {
    "light": "/assets/images/logo-light.webp",
