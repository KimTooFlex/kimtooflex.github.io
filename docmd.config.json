      "googleV4": {
        "measurementId": "G-8RDLCMTFXX"
      },
      "autoEvents": true,
      "trackSearch": true
    },
    "pwa": {
      "themeColor": "#1e293b",
      "bgColor": "#ffffff",
      "logo": "/assets/images/favicon.ico"
    },
    "ai": false,
    "git": false
  },
